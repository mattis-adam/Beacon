@page "/Dashboard"
@using Beacon.Web.Components.Ui
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject BeaconApiClient Api
@inject IConfiguration Config
@using Beacon.Contracts

<PageTitle>@Title</PageTitle>

<header class="app-header">
    <div class="brand">
        <Lighthouse Status="Global" Size="40" ShowBeams="false" />
        <span class="brand-name">Beacon</span>
    </div>
    <div class="header-actions">
        <span class="refresh">updated <RelativeTime Value="lastRefresh" /></span>
        <ThemeToggle />
    </div>
</header>

@if (error is not null)
{
    <p class="banner-error" role="alert">
        <Icon Path="@Icons.AlertCircle" Size="18" Stroke="2" />
        Unreachable Beacon API—last data shown
    </p>
}

<main class="page">
    @if (overview is null)
    {
        <p class="loading">@(error is null ? "Loading…" : "Unable to retrieve statuses at this time.")</p>
    }
    else
    {
        <GlobalHero Overview="overview" RefreshSeconds="refreshSeconds" />

        <section class="section" aria-labelledby="sources-title">
            <div class="section-head">
                <h2 id="sources-title" class="section-title">Sources</h2>
            </div>
            <div class="sources">
                @foreach (var s in SortedSources)
                {
                    <SourceCard @key="s.Id" Source="s" StaleAfter="staleAfter" />
                }
            </div>
        </section>
    }
</main>

@code {
    private StatusOverview? overview;
    private string? error;
    private DateTimeOffset? lastRefresh;

    private int refreshSeconds;
    private TimeSpan staleAfter;

    private readonly CancellationTokenSource cts = new();
    private PeriodicTimer? timer;

    private ServiceStatus Global => overview?.GlobalStatus ?? ServiceStatus.Unknown;

    private string Title => overview is null ? "Beacon" : $"Beacon · {StatusDisplay.For(Global).Label}";

    private IEnumerable<SourceSnapshot> SortedSources => overview!.Sources
        .OrderByDescending(s => StatusDisplay.For(s.Status).Label)
        .ThenBy(s => s.Name);

    protected override Task OnInitializedAsync()
    {
        refreshSeconds = Config.GetValue("Dashboard:RefreshSeconds", 30);
        staleAfter = TimeSpan.FromSeconds(Config.GetValue("Dashboard:StaleAfterSeconds", 90));
        return LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        timer = new PeriodicTimer(TimeSpan.FromSeconds(refreshSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        try
        {
            overview = await Api.GetOverviewAsync(cts.Token);
            lastRefresh = DateTimeOffset.UtcNow;
            error = null;
        }
        catch (Exception ex) when (!cts.IsCancellationRequested)
        {
            error = ex.Message;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await cts.CancelAsync();
        timer?.Dispose();
        cts.Dispose();
    }
}