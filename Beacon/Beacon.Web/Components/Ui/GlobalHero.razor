<section class="hero" aria-label="Statut global">
    <Lighthouse Status="Overview.GlobalStatus" Size="160" />

    <div class="hero-text">
        <StatusBadge Status="Overview.GlobalStatus" />
        <h1 class="hero-title">@Headline</h1>
        <p class="hero-sub">@Subtitle</p>
        <p class="hero-meta">@Overview.Sources.Count() monitored sources · refreshed all the @RefreshSeconds s</p>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public StatusOverview Overview { get; set; } = default!;
    [Parameter] public int RefreshSeconds { get; set; } = 30;

    private List<SourceSnapshot> Issues => Overview.Sources
        .Where(s => s.Status != ServiceStatus.Operational)
        .OrderByDescending(s => StatusDisplay.For(s.Status).Label)
        .ToList();

    private string Headline => Overview.GlobalStatus switch
    {
        ServiceStatus.Operational => "Everything works",
        ServiceStatus.Maintenance => "Maintenance in progress",
        ServiceStatus.Unknown => "Uncertain status",
        _ => Issues.Count == 1 ? "1 service in difficulty" : $"{Issues.Count} services in difficulty"
    };

    private string Subtitle => Issues.Count == 0
        ? "All sources respond normally."
        : string.Join(" · ", Issues.Select(s => $"{s.Name} : {s.Description ?? StatusDisplay.For(s.Status).Label}"));
}
