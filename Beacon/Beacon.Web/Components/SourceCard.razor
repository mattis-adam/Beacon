@using Beacon.Web.Components.Ui
<article class="card @CardCss">
    <div class="card-head">
        <a class="card-name" href="@Source.Url" target="_blank" rel="noopener">
            @Source.Name
            <Icon Path="@Icons.External" Stroke="2" />
        </a>
        <StatusBadge Status="Source.Status" />
    </div>

    @if (!string.IsNullOrWhiteSpace(Source.Description))
    {
        <p class="card-desc">@Source.Description</p>
    }

    <div class="card-foot">
        <span>vérifié <RelativeTime Value="Source.LastCheckedAt" /></span>
        <span>source màj <RelativeTime Value="Source.SourceUpdatedAt" Never="—" /></span>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public SourceSnapshot Source { get; set; } = default!;
    [Parameter] public TimeSpan StaleAfter { get; set; } = TimeSpan.FromSeconds(90);

    private string CardCss
    {
        get
        {
            var css = StatusDisplay.For(Source.Status).Css;  
            css += Source.Status == ServiceStatus.Operational ? " is-calm" : " is-alert";

            var stale = Source.LastCheckedAt is { } t && DateTimeOffset.UtcNow - t > StaleAfter;
            return stale ? css + " is-stale" : css;
        }
    }
}